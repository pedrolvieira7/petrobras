@model PetrobrasFInin.Models.Equipamento
@{
    ViewData["Title"] = "Novo cadastro";
}

<h1>Novo cadastro - Equipamentos</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Tag" class="form-label">Tag</label>
        <input asp-for="Tag" type="text" class="form-control" />
        <span asp-validation-for="Tag" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NomeEquipamento" class="form-label">Nome do equipamento</label>
        <input asp-for="NomeEquipamento" type="text" class="form-control" />
        <span asp-validation-for="NomeEquipamento" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <input asp-for="Tipo" type="text" class="form-control" />
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Criticidade" class="form-label">Criticidade</label>
        <input asp-for="Criticidade" type="text" class="form-control" />
        <span asp-validation-for="Criticidade" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Situacao" class="form-label">Situação</label>
        <input asp-for="Situacao" type="text" class="form-control" />
        <span asp-validation-for="Situacao" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdSetor" class="form-label">Setor</label>
        <select asp-for="IdSetor" class="form-select" asp-items="ViewBag.IdSetor">
            <option value="">-- Selecione --</option>
        </select>
        <span asp-validation-for="IdSetor" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdResponsavel" class="form-label">Responsável</label>
        <select asp-for="IdResponsavel" class="form-select" asp-items="ViewBag.IdResponsavel">
            <option value="">-- Selecione --</option>
        </select>
        <span asp-validation-for="IdResponsavel" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
