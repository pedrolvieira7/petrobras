@model PetrobrasFInin.Models.Falha
@{
    ViewData["Title"] = "Novo cadastro";
}

<h1>Novo cadastro - Falhas</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="CodigoFalha" class="form-label">Código da falha</label>
        <input asp-for="CodigoFalha" type="text" class="form-control" />
        <span asp-validation-for="CodigoFalha" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TituloFalha" class="form-label">Título</label>
        <input asp-for="TituloFalha" type="text" class="form-control" />
        <span asp-validation-for="TituloFalha" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DataOcorrencia" class="form-label">Data da ocorrência</label>
        <input asp-for="DataOcorrencia" type="date" class="form-control" />
        <span asp-validation-for="DataOcorrencia" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Criticidade" class="form-label">Criticidade</label>
        <input asp-for="Criticidade" type="text" class="form-control" />
        <span asp-validation-for="Criticidade" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Situacao" class="form-label">Situação</label>
        <input asp-for="Situacao" type="text" class="form-control" />
        <span asp-validation-for="Situacao" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdEquipamento" class="form-label">Equipamento</label>
        <select asp-for="IdEquipamento" class="form-select" asp-items="ViewBag.IdEquipamento">
            <option value="">-- Selecione --</option>
        </select>
        <span asp-validation-for="IdEquipamento" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdUsuario" class="form-label">Usuário responsável</label>
        <select asp-for="IdUsuario" class="form-select" asp-items="ViewBag.IdUsuario">
            <option value="">-- Selecione --</option>
        </select>
        <span asp-validation-for="IdUsuario" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
