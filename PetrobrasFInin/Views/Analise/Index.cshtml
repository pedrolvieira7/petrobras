@model IEnumerable<PetrobrasFInin.Models.Analise>
@{
    ViewData["Title"] = "Análises";
}

<h1>Análises</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo cadastro</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
                <th>@Html.DisplayNameFor(model => model.First().IdAnalise)</th>
                <th>@Html.DisplayNameFor(model => model.First().CodigoAnalise)</th>
                <th>@Html.DisplayNameFor(model => model.First().MetodoAnalise)</th>
                <th>@Html.DisplayNameFor(model => model.First().Disciplina)</th>
                <th>@Html.DisplayNameFor(model => model.First().DecisaoGestor)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdFalha)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdAnalista)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdGestor)</th>
                <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
                <td>@item.IdAnalise</td>
                <td>@item.CodigoAnalise</td>
                <td>@item.MetodoAnalise</td>
                <td>@item.Disciplina</td>
                <td>@item.DecisaoGestor</td>
                <td>@item.IdFalha</td>
                <td>@item.IdAnalista</td>
                <td>@item.IdGestor</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdAnalise">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdAnalise">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdAnalise">Excluir</a>
                </td>
        </tr>
}
    </tbody>
</table>
