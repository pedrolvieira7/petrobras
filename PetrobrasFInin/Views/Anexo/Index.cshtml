@model IEnumerable<PetrobrasFInin.Models.Anexo>
@{
    ViewData["Title"] = "Anexos";
}

<h1>Anexos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo cadastro</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
                <th>@Html.DisplayNameFor(model => model.First().IdAnexo)</th>
                <th>@Html.DisplayNameFor(model => model.First().NomeArquivo)</th>
                <th>@Html.DisplayNameFor(model => model.First().CaminhoArquivo)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdFalha)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdAnalise)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdAcao)</th>
                <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
                <td>@item.IdAnexo</td>
                <td>@item.NomeArquivo</td>
                <td>@item.CaminhoArquivo</td>
                <td>@item.IdFalha</td>
                <td>@item.IdAnalise</td>
                <td>@item.IdAcao</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdAnexo">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdAnexo">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdAnexo">Excluir</a>
                </td>
        </tr>
}
    </tbody>
</table>
