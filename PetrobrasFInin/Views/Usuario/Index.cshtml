@model IEnumerable<PetrobrasFInin.Models.Usuario>
@{
    ViewData["Title"] = "Funcionários";
}
<h1>Funcionários</h1>
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}
@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
<p><a asp-action="Create" class="btn btn-primary">Novo funcionário</a></p>
<table class="table table-striped table-bordered">
    <thead>
        <tr><th>Código</th><th>Nome completo</th><th>CPF</th><th>E-mail</th><th>Perfil</th><th>Ações</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.IdUsuario</td>
            <td>@item.NomeCompleto</td>
            <td>@item.Cpf</td>
            <td>@item.Email</td>
            <td>@(item.IdPerfilNavigation?.Nome ?? "-")</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdUsuario">Detalhes</a>
                @if (User.IsInRole("Administrador") || item.IdPerfilNavigation?.Nome != "Administrador")
                {
                    <span> | </span>
                    <a asp-action="Edit" asp-route-id="@item.IdUsuario">Editar</a>
                    <span> | </span>
                    <a asp-action="Delete" asp-route-id="@item.IdUsuario">Excluir</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
