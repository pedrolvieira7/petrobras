@{ Layout = null; ViewData["Title"] = "Acesso ao SIAF"; }
<!DOCTYPE html><html lang="pt-br"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Acesso ao SIAF</title><link rel="stylesheet" href="~/css/site.css"/></head><body class="auth-body"><main class="auth-shell"><section class="auth-brand-panel"><a class="auth-logo" href="/">SIAF</a><div class="auth-message"><span class="auth-kicker">PETROBRAS · CONFIABILIDADE</span><h1>Uma nova conexão começa aqui.</h1><p>Centralize registros, investigue causas e acompanhe ações corretivas com clareza e rastreabilidade.</p></div><div class="auth-bottom">Sistema de Análise de Falhas <span>Ambiente de gestão operacional</span></div></section><section class="auth-form-panel"><div class="auth-form-wrap"><div class="auth-kicker">BEM-VINDO DE VOLTA</div><h2>Acesse sua conta</h2><p class="auth-subtitle">Entre com suas credenciais para continuar.</p><form method="post" action="/Acesso/Entrar">
@Html.AntiForgeryToken()
@if (ViewBag.Erro != null) { <div role="alert" style="padding:10px;margin-bottom:12px;background:#fff0f0;color:#a12626;border-radius:7px;">@ViewBag.Erro</div> }
@if (TempData["Sucesso"] != null) { <div role="status" style="padding:10px;margin-bottom:12px;background:#edf8ef;color:#216b37;border-radius:7px;">@TempData["Sucesso"]</div> }<label for="email">E-mail corporativo</label><input id="email" name="email" type="email" placeholder="nome@empresa.com" required/><label for="senha">Senha</label><input id="senha" name="senha" type="password" placeholder="Digite sua senha" required/><div class="auth-options"><label class="remember"><input type="checkbox"/> Manter conectado</label><a href="#" onclick="alert('Solicite a redefinição ao administrador do sistema.');return false;">Esqueci minha senha</a></div><button type="submit" class="auth-submit">Entrar no sistema <span>→</span></button></form><div class="auth-note">Acesso destinado a usuários autorizados.</div><div class="auth-create">Precisa de acesso? <a href="/Acesso/CriarConta">Solicitar cadastro</a></div></div></section></main></body></html>
