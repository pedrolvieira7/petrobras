@model IEnumerable<PetrobrasFInin.Models.Perfil>
@{
    ViewData["Title"] = "Controle de permissões";
}
<h1>Controle de permissões</h1>
<p>Consulte os perfis. Para atribuir um perfil a um funcionário, utilize a seção Funcionários.</p>
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}
@if (User.IsInRole("Administrador"))
{
    <p><a asp-action="Create" class="btn btn-primary">Novo perfil</a></p>
}
<table class="table table-striped table-bordered">
    <thead><tr><th>Código</th><th>Nome</th><th>Descrição</th><th>Ações</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.IdPerfil</td><td>@item.Nome</td><td>@item.Descricao</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.IdPerfil">Detalhes</a>
                @if (User.IsInRole("Administrador"))
                {
                    <span> | </span>
                    <a asp-action="Edit" asp-route-id="@item.IdPerfil">Editar</a>
                    @if (item.Nome != "Administrador" && item.Nome != "Gestor" &&
                         item.Nome != "Analista" && item.Nome != "Operador")
                    {
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.IdPerfil">Excluir</a>
                    }
                }
            </td>
        </tr>
    }
    </tbody>
</table>
