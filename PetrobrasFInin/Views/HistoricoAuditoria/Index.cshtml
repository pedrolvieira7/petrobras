@model IEnumerable<PetrobrasFInin.Models.HistoricoAuditorium>
@{ ViewData["Title"] = "Histórico e auditoria"; }
<div class="page-heading"><div><div class="eyebrow">RASTREABILIDADE</div><h1>Histórico de operações</h1><p>Registros gravados pelo sistema: responsável, data e valores antes/depois.</p></div></div>
<section class="panel" style="padding:24px"><div class="table-responsive"><table class="table"><thead><tr><th>Data (UTC)</th><th>Usuário</th><th>Operação</th><th>Registro</th><th>Detalhes</th></tr></thead><tbody>
@foreach(var item in Model) { <tr><td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@item.IdUsuarioNavigation.NomeCompleto</td><td>@item.TipoEvento</td><td>@item.RegistroAfetado</td><td><details><summary>Ver alterações</summary><strong>Antes</strong><pre style="white-space:pre-wrap">@item.DadosAntes</pre><strong>Depois</strong><pre style="white-space:pre-wrap">@item.DadosDepois</pre></details></td></tr> }
@if (!Model.Any()) { <tr><td colspan="5">Ainda não há eventos de auditoria.</td></tr> }
</tbody></table></div></section>
