@model PetrobrasFInin.ViewModels.SiafPainelVm
@{ ViewData["Title"] = "Relatórios e indicadores"; var taxa = Model.TotalFalhas == 0 ? 0m : Math.Round(100m * Model.Concluidas / Model.TotalFalhas,1); }
<div class="page-heading"><div><div class="eyebrow">INTELIGÊNCIA OPERACIONAL</div><h1>Relatórios e indicadores</h1><p>Todos os dados são consultados diretamente no banco.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" onclick="window.print()">Imprimir / Salvar como PDF</button>@if(User.IsInRole("Administrador")||User.IsInRole("Gestor")){<a class="btn-primary-custom" asp-action="ExportarPdf">Baixar PDF</a>}</div></div>
<div class="stat-grid"><div class="stat-card"><div class="stat-top"><span>Total de ocorrências</span></div><div class="stat-number">@Model.TotalFalhas</div><div class="stat-foot">Falhas registradas</div></div><div class="stat-card"><div class="stat-top"><span>Taxa de conclusão</span></div><div class="stat-number">@taxa%</div><div class="stat-foot">Concluídas / total</div></div><div class="stat-card"><div class="stat-top"><span>Alta criticidade</span></div><div class="stat-number">@Model.Altas</div><div class="stat-foot">Alta e crítica</div></div><div class="stat-card"><div class="stat-top"><span>Análises pendentes</span></div><div class="stat-number">@Model.Pendentes</div><div class="stat-foot">Aguardando avaliação</div></div></div>
<section class="panel" style="padding:22px"><h2 style="font-size:18px">Ocorrências recentes</h2><div class="table-responsive"><table class="table"><thead><tr><th>Código</th><th>Equipamento</th><th>Data</th><th>Criticidade</th><th>Situação</th></tr></thead><tbody>@foreach(var f in Model.Recentes){<tr><td>@f.CodigoFalha</td><td>@f.IdEquipamentoNavigation.NomeEquipamento</td><td>@f.DataOcorrencia.ToString("dd/MM/yyyy")</td><td>@f.Criticidade</td><td>@f.Situacao</td></tr>}</tbody></table></div></section>
<div class="notice mt-3"><strong>Observação:</strong> os indicadores apresentados são calculados com os cadastros existentes. O MTBF requer histórico confiável do tempo de operação entre falhas; esta versão ainda não calcula esse indicador.</div>
