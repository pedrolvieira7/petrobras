@model IEnumerable<PetrobrasFInin.Models.Falha>
@{
    ViewData["Title"] = "Falhas";
}

<h1>Falhas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo cadastro</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
                <th>@Html.DisplayNameFor(model => model.First().IdFalha)</th>
                <th>@Html.DisplayNameFor(model => model.First().CodigoFalha)</th>
                <th>@Html.DisplayNameFor(model => model.First().TituloFalha)</th>
                <th>@Html.DisplayNameFor(model => model.First().DataOcorrencia)</th>
                <th>@Html.DisplayNameFor(model => model.First().Criticidade)</th>
                <th>@Html.DisplayNameFor(model => model.First().Situacao)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdEquipamento)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdUsuario)</th>
                <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
                <td>@item.IdFalha</td>
                <td>@item.CodigoFalha</td>
                <td>@item.TituloFalha</td>
                <td>@item.DataOcorrencia</td>
                <td>@item.Criticidade</td>
                <td>@item.Situacao</td>
                <td>@item.IdEquipamento</td>
                <td>@item.IdUsuario</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdFalha">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdFalha">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdFalha">Excluir</a>
                </td>
        </tr>
}
    </tbody>
</table>
