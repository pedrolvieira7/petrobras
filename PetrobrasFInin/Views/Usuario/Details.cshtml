@model PetrobrasFInin.Models.Usuario
@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes - Usuários</h1>

<dl class="row">
    <dt class="col-sm-3">Código</dt>
    <dd class="col-sm-9">@Model.IdUsuario</dd>
    <dt class="col-sm-3">Nome completo</dt>
    <dd class="col-sm-9">@Model.NomeCompleto</dd>
    <dt class="col-sm-3">CPF</dt>
    <dd class="col-sm-9">@Model.Cpf</dd>
    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Senha</dt>
    <dd class="col-sm-9">@Model.Senha</dd>
    <dt class="col-sm-3">Perfil</dt>
    <dd class="col-sm-9">@Model.IdPerfil</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
