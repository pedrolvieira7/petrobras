@model PetrobrasFInin.ViewModels.RegistroFalhaVm
@{ ViewData["Title"] = "Nova falha"; }
<div class="page-heading"><div><div class="eyebrow">ETAPA 01</div><h1>Registrar ocorrência</h1><p>Informe o equipamento, modo de falha e dados para investigação.</p></div></div>
<section class="panel" style="padding:24px;max-width:950px">
<form method="post" asp-action="NovaFalha" class="row g-3">
 @Html.AntiForgeryToken()
 <div class="col-12 text-danger" asp-validation-summary="All"></div>
 <div class="col-md-4"><label class="form-label" asp-for="CodigoFalha">Código da falha</label><input asp-for="CodigoFalha" class="form-control" placeholder="FAL-2026-001" /></div>
 <div class="col-md-8"><label class="form-label" asp-for="TituloFalha">Título</label><input asp-for="TituloFalha" class="form-control" /></div>
 <div class="col-md-6"><label class="form-label">Equipamento</label><select asp-for="IdEquipamento" asp-items="ViewBag.Equipamentos" class="form-select"><option value="0">Selecione</option></select></div>
 <div class="col-md-6"><label class="form-label">Data e hora</label><input asp-for="DataOcorrencia" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /></div>
 <div class="col-md-6"><label class="form-label">Modo da falha (referência ISO 14224)</label><input asp-for="ModoFalha" class="form-control" placeholder="Vazamento, sobreaquecimento, vibração..." /></div>
 <div class="col-md-3"><label class="form-label">Criticidade</label><select asp-for="Criticidade" class="form-select">@foreach (var opcao in new[] {"Baixa","Média","Alta","Crítica"}) { <option value="@opcao">@opcao</option> }</select></div>
 <div class="col-md-3"><label class="form-label">Horas de parada</label><input asp-for="HorasParada" type="number" step="0.1" min="0" max="100000" class="form-control" /></div>
 <div class="col-12"><label class="form-label">Descrição do ocorrido</label><textarea asp-for="Descricao" rows="5" class="form-control"></textarea></div>
 <div class="col-12"><button class="btn btn-primary" type="submit">Salvar e notificar equipe</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></div>
</form></section>
