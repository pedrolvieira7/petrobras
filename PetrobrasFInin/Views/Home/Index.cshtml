@model PetrobrasFInin.ViewModels.SiafPainelVm
@{ ViewData["Title"] = "Visão geral"; }
<div class="page-heading"><div><div class="eyebrow">CENTRO DE CONFIABILIDADE OPERACIONAL</div><h1>Painel de controle</h1><p>Dados reais do SIAF registrados no Supabase.</p></div><a class="btn-primary-custom" asp-controller="Ocorrencias" asp-action="NovaFalha">＋ Registrar falha</a></div>
<div class="stat-grid">
 <a class="stat-card" asp-controller="Ocorrencias" asp-action="Index"><div class="stat-top"><span>Falhas registradas</span><span class="stat-icon red">◉</span></div><div class="stat-number">@Model.TotalFalhas</div><div class="stat-foot">Total de ocorrências no banco</div></a>
 <a class="stat-card" asp-controller="Ocorrencias" asp-action="Index"><div class="stat-top"><span>Em investigação</span><span class="stat-icon amber">⌕</span></div><div class="stat-number">@Model.EmAnalise</div><div class="stat-foot">Em análise, revisão ou aprovação</div></a>
 <a class="stat-card" asp-controller="Ocorrencias" asp-action="Index"><div class="stat-top"><span>Ações corretivas</span><span class="stat-icon blue">✓</span></div><div class="stat-number">@Model.Acoes</div><div class="stat-foot">Planos corretivos registrados</div></a>
 <a class="stat-card" asp-controller="Equipamento" asp-action="Index"><div class="stat-top"><span>Equipamentos</span><span class="stat-icon green">▤</span></div><div class="stat-number">@Model.Equipamentos</div><div class="stat-foot">Inventário de equipamentos</div></a>
</div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Ocorrências recentes</h2><p>Registros reais do sistema</p></div><a asp-controller="Ocorrencias" asp-action="Index" class="text-link">Ver todas →</a></div>
<div class="table-responsive"><table class="table data-table"><thead><tr><th>Código</th><th>Equipamento</th><th>Criticidade</th><th>Situação</th></tr></thead><tbody>
@foreach (var f in Model.Recentes) { <tr><td><a asp-controller="Ocorrencias" asp-action="Detalhes" asp-route-id="@f.IdFalha">@f.CodigoFalha</a><small>@f.DataOcorrencia.ToString("dd/MM/yyyy")</small></td><td>@f.IdEquipamentoNavigation.NomeEquipamento</td><td>@f.Criticidade</td><td>@f.Situacao</td></tr> }
@if (!Model.Recentes.Any()) { <tr><td colspan="4">Nenhuma ocorrência cadastrada.</td></tr> }
</tbody></table></div></section>
<section class="panel"><div class="panel-heading"><div><h2>Indicadores operacionais</h2><p>Cálculos a partir do banco de dados</p></div></div>
<div class="p-3"><p><strong>@Model.Concluidas</strong> ocorrências concluídas</p><p><strong>@Model.Altas</strong> de alta criticidade ou críticas</p><p><strong>@Model.Pendentes</strong> análises aguardando aprovação</p><p>Taxa de conclusão: <strong>@(Model.TotalFalhas == 0 ? "0" : (100m * Model.Concluidas / Model.TotalFalhas).ToString("0.0"))%</strong></p><a asp-action="Relatorios" class="btn btn-primary">Abrir relatórios</a></div>
</section></div>
