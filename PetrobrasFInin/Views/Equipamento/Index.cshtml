@model IEnumerable<PetrobrasFInin.Models.Equipamento>
@{
    ViewData["Title"] = "Equipamentos";
}

<h1>Equipamentos</h1>

@if (TempData["Sucesso"] is string sucesso)
{
    <div class="alert alert-success" role="alert">@sucesso</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger" role="alert">@erro</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Novo cadastro</a>
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        Nenhum equipamento cadastrado ainda. Clique em <strong>Novo cadastro</strong> para adicionar o primeiro.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Código</th>
                <th>Tag</th>
                <th>Nome do equipamento</th>
                <th>Tipo</th>
                <th>Criticidade</th>
                <th>Situação</th>
                <th>Setor</th>
                <th>Responsável</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdEquipamento</td>
                <td>@item.Tag</td>
                <td>@item.NomeEquipamento</td>
                <td>@item.Tipo</td>
                <td>@item.Criticidade</td>
                <td>@item.Situacao</td>
                <td>@item.IdSetor</td>
                <td>@item.IdResponsavel</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdEquipamento">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdEquipamento">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdEquipamento">Excluir</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
