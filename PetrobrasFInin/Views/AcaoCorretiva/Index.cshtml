@model IEnumerable<PetrobrasFInin.Models.AcaoCorretiva>
@{
    ViewData["Title"] = "Ações corretivas";
}

<h1>Ações corretivas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo cadastro</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
                <th>@Html.DisplayNameFor(model => model.First().IdAcao)</th>
                <th>@Html.DisplayNameFor(model => model.First().CodigoAcao)</th>
                <th>@Html.DisplayNameFor(model => model.First().DescricaoAcao)</th>
                <th>@Html.DisplayNameFor(model => model.First().Prazo)</th>
                <th>@Html.DisplayNameFor(model => model.First().Situacao)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdAnalise)</th>
                <th>@Html.DisplayNameFor(model => model.First().IdResponsavel)</th>
                <th>Ações</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
                <td>@item.IdAcao</td>
                <td>@item.CodigoAcao</td>
                <td>@item.DescricaoAcao</td>
                <td>@item.Prazo</td>
                <td>@item.Situacao</td>
                <td>@item.IdAnalise</td>
                <td>@item.IdResponsavel</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.IdAcao">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdAcao">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdAcao">Excluir</a>
                </td>
        </tr>
}
    </tbody>
</table>
